# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# Editor
.idea/

# Secrets — never commit tokens or keys.
.env
.env.*
*.pem

# Derived corpus file. Rebuild with `python src/build_combined.py`.
# 1.8 MB that duplicates every corpus/doc-NN.md byte-for-byte, so committing it
# would double the repo size and make every corpus diff show up twice.
corpus/combined.md

# NOT ignored, deliberately:
#   corpus/doc-*.md   the frozen corpus IS the dataset — an interviewer needs it
#                     to reproduce any number, and the sha256 in corpus/INDEX.md
#                     is meaningless without the bytes it fingerprints.

.venv/

# Derived: rebuild with src/embed.py. 2.6 MB binary, unreadable diffs.
index/vectors.npz

# Private working notes — personal planning docs, not part of the project.
# These were removed from git history before the repo went public. Re-adding
# them (`git add -f`) would undo that, so don't.
#
# One directory rule instead of five filenames: a new personal doc is private
# by virtue of where it lives, so there is no filename left to forget.
# Nothing in here is version-controlled — git cannot restore what it never saw.
private/
